# Copy to .env locally. Set these in Render's Environment page when deployed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Fast disables thinking; thinking and auto enable it. Tool availability is identical.
# Per-answer limits: 300 seconds by default (hard cap 900), 7/14 model requests
# through the Harness. PLECS groups share this budget; no fixed two-group limit.
# Cost is per answer, in USD, not daily spend or provider balance.
# Known DeepSeek models default to published peak USD rates, with cache discounts.
AGENT_TIME_LIMIT_S=300
AGENT_COST_LIMIT_USD=0.50
# Optional overrides for a custom model/proxy; unset to use model-specific prices.
# AGENT_INPUT_USD_PER_M=0.30
# AGENT_CACHED_INPUT_USD_PER_M=0.006
# AGENT_OUTPUT_USD_PER_M=1.20
# Per-request output cap includes thinking. Defaults: auto/thinking 32768, fast 8192.
# AGENT_MAX_OUTPUT_TOKENS=32768
# Only the origin, without the repository path. Separate multiple origins by commas.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Required in production. This is your app password, NOT the DeepSeek API key.
APP_ACCESS_TOKEN=
APP_ENV=development
SOURCE_URL=
# Optional: absolute path to an existing Python with torch (local only).
PANN_PYTHON=
# Local default: runtime/archive. On Render mount a persistent disk at /var/data,
# then set ARCHIVE_DIR=/var/data/buck-archive. An env var alone is NOT a disk.
ARCHIVE_DIR=
# Maximum CSV bytes per private sync archive (512 MiB); does not auto-delete files.
ARCHIVE_MAX_BYTES=536870912

# Official Harness uses Messages API; leave blank for DEEPSEEK_BASE_URL + /anthropic.
HARNESS_BASE_URL=
# Mount persistent storage first; e.g. /var/data/buck-agent on Render paid disk.
AGENT_RUNTIME_DIR=
# Optional override. Defaults to 1 on Render and 2 locally.
# AGENT_MAX_ACTIVE_TASKS=1
