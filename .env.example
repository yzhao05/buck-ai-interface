# Copy to .env locally. Set these in ModelScope Studio's environment settings (use secrets for credentials) when deployed.
# Direct mode: set OPENAI_API_KEY on the backend.
# Connector mode: set OPENAI_RELAY_TOKEN (32+ random characters) in Studio.
# On the PC, python -m backend.openai_companion prompts for both credentials.
OPENAI_RELAY_TOKEN=
OPENAI_API_KEY=
OPENAI_MANUAL_MODEL=gpt-6.1-terra
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Fast: DeepSeek thinking off, Terra low effort. Thinking: high effort. Both modes have the same tools.
# Chat requests use the provider output defaults. Usage estimates are recorded after completion.
# Optional overrides for a custom model/proxy; unset to use model-specific prices.
# AGENT_INPUT_USD_PER_M=0.30
# AGENT_CACHED_INPUT_USD_PER_M=0.006
# AGENT_OUTPUT_USD_PER_M=1.20
# Only the origin, without the repository path. Separate multiple origins by commas.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Required in production. This is your app password, NOT the DeepSeek API key.
APP_ACCESS_TOKEN=
APP_ENV=development
# Optional absolute path to the full local manual_documents.csv.
BUCK_MANUAL_ARCHIVE=
SOURCE_URL=
# Optional: absolute path to an existing Python with torch (local only).
PANN_PYTHON=
# Local default: runtime/archive. The Studio image uses /mnt/workspace/buck-lab/archive.
# Verify that the directory is backed by persistent storage.
ARCHIVE_DIR=
# Maximum CSV bytes per private sync archive (512 MiB); does not auto-delete files.
ARCHIVE_MAX_BYTES=536870912

# Official Harness uses Messages API; leave blank for DEEPSEEK_BASE_URL + /anthropic.
HARNESS_BASE_URL=
# The Studio image uses /mnt/workspace/buck-lab/agent for Agent task data.
AGENT_RUNTIME_DIR=
# Optional override. The Studio image sets this to 1; local default is 2.
# AGENT_MAX_ACTIVE_TASKS=1
